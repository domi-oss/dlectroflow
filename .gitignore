# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Local AI session handoff notes (internal scratchpad, not public)
/.remember/

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts

# CI build staging (build_app stages standalone output here for Kaniko)
/ci-dist/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment / secrets
.env
.env*.local
.env.local
# Single-host production stack (#102): real secrets + local dump destination
.env.prod
/backups/

# Prisma / local database
/prisma/*.db
/prisma/*.db-journal
*.sqlite
*.sqlite3

# Vercel / IDE
.vercel
.idea
.vscode
# ...except the workspace settings, which are shared project configuration
# rather than personal state (#133): they pin the Vitest extension to the
# config file that moved out of the root. Everything else VS Code writes here
# (launch.json, per-user overrides, extension caches) stays ignored.
!.vscode/
.vscode/*
!.vscode/settings.json
*.tsbuildinfo

# Superpowers SDD agent scratch (briefs, reports, review diffs, ledger)
/.superpowers/

# Claude Code local state + background-agent git worktrees (never committed)
.claude/
# Nested build output inside agent worktrees (root /.next/ above only anchors top-level)
**/.next/

# Playwright
/playwright/.auth/
/playwright-report/
/test-results/
/.playwright/
