{
  "name": "dlectroflow",
  "version": "0.5.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "dlectronique",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "setup": "docker compose -f docker/docker-compose.yml up -d db && npm install && prisma migrate dev",
    "purge:scheduled": "tsx prisma/scheduled-purge.ts",
    "seed:allowlist": "tsx prisma/seed-allowlist.ts",
    "check:env": "tsx scripts/check-env-drift.ts"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "prettier": "./config/prettier.config.mjs",
  "overrides": {
    "postcss": "^8.5.16",
    "sharp": "^0.35.3",
    "brace-expansion": "^5.0.9",
    "minimatch@^3": {
      "brace-expansion": "^2.1.4"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.0",
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "openai": "^6.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.16.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop-unit-testing": "2.0.0",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "16.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "shadcn": "4.13.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
