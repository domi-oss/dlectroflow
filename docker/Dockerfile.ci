# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
# Dockerfile.ci — used only in CI pipelines.
#
# Expects the following to already exist as CI artifacts (built by the
# build_app job using npm ci + next build):
#   ci-dist/standalone/   (the .next/standalone output)
#   ci-dist/static/       (the .next/static output)
#   public/
#   prisma/
#   prisma.config.ts
#
# NOTE: build_app stages its output under ci-dist/ rather than .next/ because
# .dockerignore excludes .next — Kaniko honors .dockerignore and would strip
# the standalone artifact from its build context, producing an image with no
# server.js (crash-loop: "Cannot find module '/app/server.js'"). ci-dist/ is
# not ignored, so it survives into the Kaniko context.
#
# This file intentionally skips the build stage so Kaniko only assembles
# the final image. All layers here are stable and will almost always be
# Kaniko cache hits. For local development builds, use the regular Dockerfile.
#
# Keep this stage and the runtime stage of ./Dockerfile in lock-step — the
# guards in src/lib/dockerfile-hygiene.test.ts assert both (#71).

# alpine (musl) base — dramatically smaller attack surface than Debian: no
# perl-base, no Debian zlib1g/ncurses/gzip, so the container-scan CVEs that had
# no upstream Debian fix (#1) simply don't exist here. openssl is needed by the
# Prisma engine. apk upgrade keeps the base current on every build.
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runner
WORKDIR /app
RUN apk upgrade --no-cache && apk add --no-cache openssl
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# ── Cluster-invoked CLIs: prisma + tsx (+ dotenv for prisma.config.ts) ───────
# The migrate initContainer runs `npx prisma migrate deploy`, the review-only
# seed runs `npx tsx prisma/seed.ts`, and the purge CronJob runs
# `npx tsx prisma/scheduled-purge.ts` — all from THIS image with /app as the
# working directory, so those binaries must resolve from /app/node_modules.
#
# They are installed into an ISOLATED prefix and grafted in afterwards. Run in
# /app, `npm install` treats the standalone output's package.json as the project
# manifest and reinstalls the app's ENTIRE dependency tree on top of the minimal
# traced node_modules (+392 packages: next, typescript, playwright, @next/swc,
# …). That, plus npm's 885 MB tarball cache, was the bulk of the 893 MB image
# whose cold pull timed out Autopilot deploys (#71).
#
# One RUN, so the npm cache never survives into a layer; first in the file, so
# it stays a cache hit on every app-only change. Versions are pinned to
# package-lock.json (guarded by src/lib/dockerfile-hygiene.test.ts) so the
# container never runs migrations on a different Prisma than the app was built
# against.
#
# ⚠️ The manifest below carries its own `overrides`, and it MUST: because this
# prefix is isolated, npm reads THIS package.json as the project root, so the
# `overrides` in the repo's package.json do not apply here. Anything that has to
# be forced in the shipped image has to be forced twice — once for the repo (CI,
# local dev, and what the dependency scanner reads out of package-lock.json) and
# once here, for the copy that is actually grafted into /app/node_modules and
# runs in the cluster. `deepmerge-ts` is pinned to ^8.0.1 for CVE-2026-40345
# (HIGH, stack exhaustion on recursive object graphs): `prisma` pulls
# `@prisma/config`, which depends on `deepmerge-ts` at an EXACT `7.1.5`, so no
# range bump reaches it and naming the package on the install line below does not
# either — measured in node:22-alpine, that produces a hoisted 8.0.1 AND a nested
# @prisma/config/node_modules/deepmerge-ts@7.1.5, which is the copy
# @prisma/config would load. Only an override collapses it to one.
#
# This is the load-bearing half of that fix. Fixing only the repo's package.json
# turns the dependency scan green while the running image still carries the
# vulnerable copy, because the scanner reads the lockfile and the pod gets this
# install. Do not "simplify" the overrides block out; dockerfile-hygiene fails if
# it goes missing.
RUN mkdir -p /opt/tools \
  && printf '{"name":"dlectroflow-image-tools","private":true,"overrides":{"deepmerge-ts":"^8.0.1"}}\n' > /opt/tools/package.json \
  && cd /opt/tools \
  && npm install --no-audit --no-fund --cache /tmp/npm-cache \
       prisma@6.19.3 dotenv@16.6.1 tsx@4.23.1 \
  && mkdir -p /app/node_modules \
  && cp -a /opt/tools/node_modules/. /app/node_modules/ \
  && rm -rf /opt/tools /tmp/npm-cache /root/.npm \
  && chown -R node:node /app

# Schema + migrations for the migrate initContainer, then the rarely-changing
# assets, then the per-commit build output: cheapest layer churn for node-level
# image caches.
#
# COPY --chown replaces the trailing `RUN chown -R node:node /app` this file
# used to end with: chown rewrites every file it touches, so that single line
# wrote a second full copy of /app into its own layer (+854 MB) (#71).
COPY --chown=node:node prisma ./prisma
COPY --chown=node:node prisma.config.ts ./prisma.config.ts
COPY --chown=node:node public ./public

# Standalone server (server.js at /app, minimal traced node_modules). Copied
# after the tooling so the app's traced dependencies win any name collision.
COPY --chown=node:node ci-dist/standalone ./
COPY --chown=node:node ci-dist/static ./.next/static

# ── Which commit this image is (#135) ────────────────────────────────────────
# /api/health reports the short form, so Instance A (this image, on Kubernetes)
# and Instance B (the Compose self-host stack) can be ASSERTED to be on the same
# commit instead of assumed to be. It has to be baked in here: a running
# container cannot read the registry tag it was pulled under, even though for
# this image that tag IS $CI_COMMIT_SHA.
#
# build_image passes `--build-arg BUILD_SHA=$CI_COMMIT_SHA` (.gitlab-ci.yml).
# ENV, not just ARG: an ARG is build-time only and never reaches the process.
# LAST in the file on purpose — the value changes every commit, so it must sit
# below every layer Kaniko caches; only metadata follows it. Keep in lock-step
# with ./Dockerfile; src/lib/dockerfile-hygiene.test.ts asserts both carry the
# pair, since one missing it silently makes the comparison impossible.
ARG BUILD_SHA=""
ENV BUILD_SHA=$BUILD_SHA

# Run as the non-root `node` user (uid 1000, present in node images).
USER node

EXPOSE 3000
CMD ["node", "server.js"]
