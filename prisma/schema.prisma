// dlectroflow data model — see docs/dlectroflow-plan.md for feature specs.
// PostgreSQL everywhere (local dev via Docker Compose, production on GitLab).
// Note: status/role/outcome are String (allowed values documented inline +
// mirrored in src/lib/constants.ts) and arrays are JSON/CSV strings.

generator client {
  provider      = "prisma-client-js"
  // native = local dev (mac / glibc Linux); linux-musl-openssl-3.0.x = the
  // alpine (musl) runtime image built by docker/Dockerfile.ci. Both engines are
  // generated so the client works locally AND in the deployed container.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Accounts (#35 Phase A) ────────────────────────────────────────────────
// Invite-only identity. A User owns exactly one Workspace; content lives on the
// workspace, never on the user, so "the owner sees usage, never content" stays
// structurally true. role/status/aiPolicy are pseudo-enums mirrored in
// src/lib/constants.ts + CHECK constraints (see the accounts_identity migration).
model User {
  id          String    @id @default(cuid())
  provider    String // "gitlab" — see #74 for more providers
  providerSub String // stable subject from the provider, never the email
  email       String?
  handle      String? // provider username, lowercased
  // #252 — what this person wants to be CALLED. The first field on the account
  // they choose themselves: `handle` is the lowercased username the OAuth
  // provider issued and `id` is a cuid, so before this the header could only
  // ever greet somebody by a name they did not pick.
  //
  // On User and not on Settings, because a name is person-scoped and Settings is
  // workspace-scoped — a workspace has members (identityFor returns a role), so
  // a name stored there would be one name for everybody in it.
  //
  // Nullable with NO default and NO backfill, deliberately: the migration that
  // adds it must be pure metadata. See the 2026-08-06 P3009 outage — data
  // migrations here are only ever exercised against empty tables, so "every
  // existing row is untouched" is the only property that can be relied on.
  // `accountLabel()` therefore has to render a null as well as it renders a
  // name, and does.
  displayName String?
  role        String    @default("member") // owner | member
  status      String    @default("active") // active | revoked
  aiPolicy    String    @default("capped") // uncapped | capped | own_key
  aiQuota     Int       @default(50) // breakdowns per rolling window when capped
  llmProvider String? // null = instance default (Phase C)
  llmKeyEnc   String? // token-cipher ciphertext, never returned to a client (Phase C)
  revokedAt   DateTime?
  purgeAfter  DateTime?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  workspace    Workspace?
  aiUsage      UserAiUsage?
  allowlistRow Allowlist?
  googleAuth   GoogleAuth?
  calendarFeed CalendarFeed?

  @@unique([provider, providerSub])
  @@index([status, purgeAfter])
}

// An invitation. `identity` is whatever the owner typed — a provider username,
// an email, or the provider's numeric subject — lowercased at the boundary.
model Allowlist {
  id          String    @id @default(cuid())
  provider    String
  identity    String
  // Does claiming this invitation make the claimer the instance owner?
  //
  // A dedicated boolean, NOT a sentinel value in `note`: a free-text field
  // deciding a privilege level is a privilege-escalation hole, because any row
  // that happens to carry the magic string — set by accident, by a future
  // People admin UI, or by copy-paste — would silently mint an owner.
  //
  // Only prisma/seed-allowlist.ts sets it, from the deploy-time OWNER_ALLOWLIST.
  // Deliberately narrower than a general `role` column: the People UI (Phase B)
  // invites members, and should not be able to grant ownership at all.
  isOwnerSeed Boolean   @default(false)
  note        String?
  invitedAt   DateTime  @default(now())
  claimedAt   DateTime?
  claimedById String?   @unique
  // A bare `claimedById String?` would be a plain column with no foreign key,
  // so a claim pointing at a deleted user would silently dangle. SetNull keeps
  // the allowlist row (the invitation is still a fact) but drops the pointer.
  claimedBy   User?     @relation(fields: [claimedById], references: [id], onDelete: SetNull)

  @@unique([provider, identity])
}

// Mirrors the mechanism GuestAiUsage already uses — a single row per subject
// carrying a sliding window, NOT one row per day — so consumeGuestBreakdown's
// atomic-increment pattern transfers unchanged in Phase B.
model UserAiUsage {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Workspaces (user = one per account; guests = ephemeral) ────────────────
model Workspace {
  id         String    @id @default(uuid())
  kind       String    @default("guest") // user | guest ("owner" = legacy pre-#35 row
  //                                       kept only so the CHECK still validates it)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime? // guest sandbox TTL (null = user workspace / no expiry)

  // 1:1 with the account that owns it. Nullable because guest workspaces have
  // no user; Cascade so deleting an account destroys its content in one step.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  settings        Settings?
  streak          Streak?
  brainDumpItems  BrainDumpItem[]
  tasks           Task[]
  focusSessions   FocusSession[]
  focusPlaylists  FocusPlaylist[]
  dayRollups      DayRollup[]
  rewardEvents    RewardEvent[]
  streakRecords   StreakRecord[]
  badges          Badge[]
  dailySparks     DailySpark[]
  shoppingItems   ShoppingItem[]
  shoppingSummary ShoppingSummary?

  @@index([lastSeenAt])
}

// ── Singleton config (one row per workspace, keyed by workspaceId) ───────
model Settings {
  id                       String    @id @default(cuid())
  // Feature 1 — aging
  agingThresholdMinutes    Int       @default(240)
  demoOverrideSeconds      Int? // aging demo override (~10s) to fire live on stage
  // Feature 3 — timer + round-up
  defaultFromEstimate      Boolean   @default(true)
  addTimeIncrementMin      Int       @default(5)
  workdayEndTime           String    @default("17:00") // HH:mm
  roundupDemoOverride      Boolean   @default(false)
  roundupEmailEnabled      Boolean   @default(false)
  roundupEmail             String?
  // Feature 4 — streaks
  workingDays              String    @default("1,2,3,4,5") // ISO weekdays, Mon=1..Sun=7
  // Phase 2 — owner-selected breakdown model (null = env/default)
  breakdownModel           String?
  // Voice preference: "plain" (default) or "playful"
  voice                    String    @default("plain")
  // Phase 2 — per-tier freshness thresholds (hours)
  agingHours               Int       @default(4)
  overdueHours             Int       @default(8)
  wayOverdueHours          Int       @default(12)
  // Phase 5 — first-run welcome + demo preview
  welcomeDismissedAt       DateTime?
  firstRunPreview          Boolean   @default(false)
  // Phase 6 — per-type notification preferences (client-delivered only)
  notifyRoundup            Boolean   @default(true)
  notifyAging              Boolean   @default(true)
  notifyDailyReview        Boolean   @default(false)
  dailyReviewNudgeTime     String    @default("17:00") // HH:mm
  // MR ② — Focus timer redesign (appearance + behaviour). focusTimerStyle
  // (nullable → resolve by voice) + focusSound mirror FocusTimerStyle /
  // FocusSound in src/lib/constants.ts + their CHECK constraints
  // (Settings_focusTimerStyle_check / Settings_focusSound_check).
  focusTimerStyle          String? // ring | digits | bar | mug (null → voice default)
  focusMinimalMode         Boolean   @default(false)
  focusKeepAwake           Boolean   @default(true)
  focusAlarmEnabled        Boolean   @default(true)
  // #180 — a switch, not a track picker: the column narrowed to off | on and
  // nothing persists an opening track any more. It defaults ON for NEW rows,
  // which is the whole point — a catalogue you only hear after finding a
  // settings page is a feature in hiding. Existing rows are untouched by that
  // default, and src/lib/focus-sound-migration-hygiene.test.ts fails the build
  // if a migration ever switches one on.
  focusSound               String    @default("on") // off | on (see FocusSound)
  // #180 — which categories the session's playlist draws from; chosen in the
  // player, not here. An EMPTY array means the whole catalogue, which is what
  // #70's nullable single slug meant by NULL, so no reader changed meaning.
  // Collapsing "nothing narrowed" onto the empty array leaves exactly one way to
  // say it and exactly one way to get silence (focusSound above).
  //
  // Postgres text[] guarded by CONTAINMENT (Settings_focusSoundCategories_check
  // — `<@ ARRAY[…]`), mirroring FocusSoundCategory in src/lib/constants.ts. It
  // is NOT NULL because `NULL <@ ARRAY[…]` is NULL and a CHECK passes on NULL,
  // so a nullable column would accept a value nothing validated.
  focusSoundCategories     String[]  @default(["ambient-lofi"])
  // #185 — which of the workspace's OWN named playlists (FocusPlaylist) the
  // session also draws from. A sibling of focusSoundCategories, deliberately not
  // a merged "qualified reference" array of `cat:…` / `pl:…` strings: that shape
  // would have nothing to CHECK, and Settings_focusSoundCategories_check is the
  // only thing keeping a hand-edited category slug out of the column above.
  //
  // No CHECK and no foreign key here, because a scalar list can have neither.
  // The ids are cuids of rows in the SAME workspace, and two things hold that
  // together in the absence of one: deleteFocusPlaylist strips the id from every
  // selection that names it, and the write path filters to playlists the
  // resolved workspace actually owns — so a foreign id cannot be stored even if
  // one is posted. An id that survives both (a delete racing a tick) resolves to
  // no tracks and is ignored, the same way an absent category is.
  focusPlaylistIds         String[]  @default([])
  // #68 — playlist shuffle for the focus mini-player. A taste setting, so it
  // persists across sessions. Plain Boolean: no pseudo-enum, hence no CHECK
  // constraint to mirror in src/lib/constants.ts. #180 flipped the default to
  // true for new accounts, alongside sound-on: an unshuffled default plays the
  // same track first every session.
  focusShuffle             Boolean   @default(true)
  // #65 — make the #43 music↔timer coupling bidirectional: pausing the music
  // from the mini-player also pauses the timer (and playing it resumes both).
  // Opt-in, so it defaults false — the timer→music direction is unconditional,
  // but stopping a focus session is never something to infer from "quiet,
  // please". Plain Boolean, like focusShuffle: no CHECK constraint to mirror.
  focusPauseTogether       Boolean   @default(false)
  // #252 — does the header carry a quick-access icon for the focus timer?
  //
  // The one new gate the header's quick-access cluster needs. The trolley's gate
  // already existed (`shoppingList` below) because /shopping is an optional
  // feature; /focus is not optional, so nothing governed its AVAILABILITY —
  // only its appearance (focusTimerStyle, focusSound, …). The owner asked for
  // this icon to be optional, so it gets a column of its own rather than being
  // hung off one of those.
  //
  // Defaults ON: focus is the payoff step of the app's core loop and the button
  // was asked for, so an account that never opens Settings should have it. One
  // toggle turns it off. Plain Boolean, like focusShuffle and shoppingList: no
  // pseudo-enum, hence no CHECK constraint to mirror in src/lib/constants.ts.
  focusQuickAccess         Boolean   @default(true)
  focusTimerTipDismissedAt DateTime?
  // #199 — shopping-list mode. OFF by default: the whole point of the switch is
  // that the feature adds no surface for people who don't want it, so an existing
  // workspace and a brand-new one both start without it. Plain Boolean, like
  // focusShuffle: no pseudo-enum, hence no CHECK constraint to mirror in
  // src/lib/constants.ts. Turning it off HIDES the list, it does not delete it —
  // the rows survive and reappear if it is turned back on.
  shoppingList             Boolean   @default(false)
  // MR ③ — app-wide completion style (Appearance). completeTickColor mirrors
  // CompleteTickColor in src/lib/constants.ts + Settings_completeTickColor_check.
  completeStrikethrough    Boolean   @default(true)
  completeTickColor        String    @default("green") // green | black
  // #40 — user-selected UI typeface (a11y). Mirrors Typeface in
  // src/lib/constants.ts + Settings_typeface_check.
  typeface                 String    @default("figtree") // figtree | atkinson | opendyslexic | system
  updatedAt                DateTime  @updatedAt
  workspaceId              String    @unique
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ── Google Tasks OAuth (tokens obtained at runtime) ───────────────────────
// client_id/secret come from env (GOOGLE_CLIENT_ID/SECRET); only tokens here.
//
// #118 Phase C: ONE ROW PER USER, keyed on `userId`. src/lib/google.ts is the
// only module that touches this table, every function there takes the acting
// user's id, and none of them accepts a row id — so there is nothing a caller
// could point at another account's credential.
//
// History, because two earlier comments here were wrong and the wrong one was
// load-bearing: Phase A dropped the `@default("singleton")` id and DELETEd every
// row, but application code kept supplying `id: "singleton"` explicitly, so one
// instance-wide row was re-created on demand and sync never went down (#119).
// Phase C's migration destroys that orphan (userId IS NULL) rather than adopting
// it, and the owner reconnects once.
//
// A credential belongs to exactly one account, and `userId` is NOT NULL in the
// database to say so (#122, 20260804120000_google_auth_user_id_not_null). It was
// nullable for exactly one release on purpose — the code #118 replaced wrote a
// NULL userId on every page load, so SET NOT NULL during that rolling update
// would have 500'd the inbox — and #118's purge above was the repair half.
//
// src/lib/__tests__/scoping.harness.test.ts remains the PRIMARY guard: it fails
// CI if any prisma.googleAuth.* call does not name userId, which beats a runtime
// constraint violation. The column constraint is the layer beneath it, for the
// writers a static scan of the repo cannot see (raw SQL, psql, an old dump).
// Proof that it is applied and that it bites:
// src/lib/google-auth-user-id-not-null.integration.test.ts.
model GoogleAuth {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  scope          String?
  needsReconnect Boolean   @default(false)
  updatedAt      DateTime  @updatedAt
}

// ── Calendar subscription feed (#154) ─────────────────────────────────────
// ONE ROW PER USER, keyed on `userId` exactly as UserAiUsage is, so an account
// has one feed or none and "turn it off" is a row that stops existing.
//
// `token` is a CAPABILITY: a calendar client cannot present a session cookie, so
// possession of the URL is the entire authorization. It is 256 bits from a
// CSPRNG (src/lib/calendar-feed.ts), which is why nothing here is rate-limited
// against guessing — 2^256 is not a search space.
//
// STORED IN PLAINTEXT, deliberately, and this is the decision most worth
// arguing with. Hashing a bearer token protects against a read-only leak of the
// database — but this token grants read access to data that is IN THAT SAME
// DATABASE, so an attacker holding the rows has already got everything the token
// would fetch. The marginal security is therefore ~zero, while the cost is real:
// a hash can only be shown once, and a feed URL you cannot re-copy onto a second
// device is one people paste into a note, which is strictly worse. The
// comparison is with `llmKeyEnc` and `GoogleAuth.accessToken`, which ARE
// protected — both are credentials to a THIRD PARTY, where the leak reaches past
// this database. This one does not.
//
// WHERE THAT ARGUMENT STOPS (#154 review). It holds for a live database, where
// holding the rows and holding the token get you the same data at the same
// moment. It does NOT carry to a backup, and the difference is not a detail:
//
//  - A dump leaves the database's failure domain — that is what a backup is for
//    — so the copy and the thing it copies do not fail, leak or get restored
//    together. "The attacker already has the data" assumes one blast radius.
//  - A dump is a snapshot; the token in it is not. Nothing about restoring,
//    copying or losing a dump rotates anything, so a token read out of a
//    six-month-old one is a live, forward-looking read capability against
//    TODAY'S data — including everything written after the snapshot. The rest of
//    the dump ages into a historical record. This column does not age at all.
//
// That is a real cost of the plaintext decision, not a reason to reverse it: the
// re-copyable URL is still worth more than a hash whose only benefit accrues in
// the case handled below. It is paid for operationally instead — every dump you
// cannot account for is a token disclosure, and `docs/deploy-runbook.md` §15
// step 5 rotates the whole table. `rotatedAt` is what makes that auditable.
//
// The same asymmetry is why the token is worth rotating after a log exposure:
// it travels in the request path, so it outlives the request in the access log
// (runbook §16) exactly as it outlives the snapshot in a dump.
//
// `rotatedAt` is nullable and means "never regenerated". Both timestamps are
// audit columns rather than UI: a credential with no record of when it was
// issued or last rotated is one you cannot reason about during an incident.
//
// Cascade on the user, so deleting an account destroys the feed with it. A
// REVOKED account is a different case — the row survives a freeze (#153) and the
// feed is refused at resolve time by checking `User.status`, on the same
// reasoning currentUser() gives for reading the role from the database: a
// revocation has to take effect on the next request, not whenever something
// expires.
model CalendarFeed {
  userId    String    @id
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
}

// ── Feature 1 — Brain Dump ────────────────────────────────────────────────
model BrainDumpItem {
  id                   String    @id @default(cuid())
  text                 String
  createdAt            DateTime  @default(now())
  status               String    @default("inbox") // inbox | triaged | archived
  triagedAt            DateTime?
  remindedAt           DateTime?
  snoozedUntil         DateTime?
  freshenedAt          DateTime?
  promptDismissedAt    DateTime?
  completedAt          DateTime?
  // Single-task time estimate (minutes). Nullable, and null is MEANINGFUL: it
  // says the user never gave an estimate, and the read side substitutes a
  // display default (5) rather than storing one.
  //
  // #80 — enforced in the DB by BrainDumpItem_estMinutes_check
  // (20260731120000_braindump_item_est_minutes_check) as
  // `IS NULL OR >= 1`, NOT the plain `>= 1` that Step.estMinutes gets from
  // Step_estMinutes_check (#78). That asymmetry is a recorded decision, not an
  // oversight: Step.estMinutes is NOT NULL so `>= 1` is its whole invariant,
  // whereas a plain `>= 1` here would reject every estimate-less item and break
  // createItem — which omits this column — on its first insert. Zero and
  // negative are still exactly as wrong here as they are on Step, so they are
  // refused. Prisma can't express a CHECK constraint, so this comment is its
  // only trace in the schema; it is registered alongside the pseudo-enum
  // constraints in src/lib/enum-constraint-sync.integration.test.ts
  // (RANGE_REGISTRY, with nullable: true pinning the NULL allowance).
  estMinutes           Int?
  // Set when the item is moved into Multi-step without steps yet — it sits in
  // the Multi-step bucket with a "Break into steps now?" call-to-action.
  // Cleared by any move to another bucket.
  breakdownRequestedAt DateTime?
  // #186 — the Schedule menu's three fields, at the ITEM grain. Mirrors the
  // `Task` trio below field-for-field, including the NO COLUMN DEFAULT decision
  // and for the same reason: NULL is what makes `mergePersistedIntent` fall
  // back to `defaultIntentFor()` per field, so a default would make "the owner
  // chose this" indistinguishable from "nobody has said yet".
  //
  // The item grain exists because the full menu was previously reachable only
  // from a multi-step task — not a UI omission, but the absence of anywhere to
  // persist a deadline for an item with no `Task` row. `loadScheduleIntent`
  // (src/app/actions/schedule-intent.ts) resolves task-backed and item-backed
  // intents to the same `ScheduleIntent` shape, so no call site learns which
  // kind it got.
  //
  // Both pseudo-enum columns mirror SchedulePriority / ScheduleHours in
  // src/lib/scheduling/types.ts and are CHECK-constrained by
  // 20260807120000_braindump_item_notes_and_schedule; Prisma can't express a
  // CHECK, so these comments are their only trace in the schema and the
  // constraints are registered in
  // src/lib/enum-constraint-sync.integration.test.ts.
  scheduleDueAt        DateTime?
  schedulePriority     String? // critical | high | normal | low
  scheduleHours        String? // work | personal
  // #186 / #179 — the owner's freeform note on an UNTRIAGED item: typed into
  // the Needs-review row's disclosure, or split off the capture itself when the
  // text ends in a brace group (`water the plants {can under sink}`, #179).
  //
  // Nullable, and the NULL is load-bearing exactly as it is on `Task.notes`:
  // "nobody has written a note" is what keeps a blank line out of a calendar
  // entry, and `normalizeTaskNote` (src/lib/task-notes.ts) — shared, not
  // re-declared — folds "" and whitespace-only back to NULL.
  //
  // Bounded at 2000 CHARACTERS by BrainDumpItem_notes_check
  // (20260807120000_braindump_item_notes_and_schedule), the same bound as
  // `Task.notes` because this value is COPIED into that column at triage by
  // `brainDumpItemToTaskData` (src/lib/braindump-to-task.ts) — a wider bound
  // here would be a value the narrower column refuses on a routine action.
  // Registered in src/lib/enum-constraint-sync.integration.test.ts
  // (LENGTH_REGISTRY); behavioural half in
  // src/lib/notes-length-check.integration.test.ts.
  notes                String?
  // #175 — idempotency key for a capture replayed from the offline queue.
  //
  // Client-generated (`newClientKey`, src/lib/capture-queue.ts) and unique PER
  // WORKSPACE, not globally: the value comes from the browser, so two tenants can
  // legitimately mint the same one, and a global unique index would both refuse a
  // valid write and tell one workspace that another holds that key.
  //
  // NULLABLE, and the null is load-bearing twice over. Every row that predates
  // this migration has none, and every ordinary online capture leaves it unset —
  // Postgres treats nulls as distinct in a unique index, so any number of them
  // coexist. A NOT NULL column here would break `createBrainDumpItem` on its next
  // insert.
  //
  // Why it exists at all: `withActionTimeout` bounds how long the UI waits, NOT
  // the request (see its docblock in src/lib/server-action-failure.ts), so a write
  // that times out at CAPTURE_TIMEOUT_MS and lands four seconds later is ordinary
  // on a mobile connection. Without this key every automatic flush would duplicate
  // it. One column serves two purposes: replay-on-reconnect, and the late-write
  // duplicate #210 recorded as its own residual.
  //
  // It IS carried by export.json, and that is a decision rather than an accident
  // (Duo review, !334). `ExportSnapshot.inbox` is typed `BrainDumpItem[]` and
  // `collect.ts` reads the rows with no `select`, so a new column reaches the
  // archive by default — which is the behaviour the export wants, and is why the
  // fixture literal is typed against the whole model. Kept rather than excluded:
  //
  //  * It is not a secret. `capture-queue.ts` says so in as many words — an
  //    idempotency key grants nothing without the workspace it is unique within —
  //    so the `select` that keeps `llmKeyEnc` out of the account row is a control
  //    for credentials and does not reach this.
  //  * `DELIBERATELY_EXCLUDED` in export/__tests__/model-coverage.test.ts is keyed
  //    by MODEL, not by field, so it is not the instrument for this even if the
  //    answer had been to exclude it. Its one entry also justifies itself on
  //    "nothing the exported rows do not already carry"; a per-row key is not that.
  //  * Excluding it would mean adding a `select` to that read, which narrows
  //    `inbox` from the whole model to a picked type and DESTROYS the compile-time
  //    tripwire that makes the next new column a build error in the fixture. That
  //    net is worth more than hiding a field that is null on every online capture.
  //
  // The CSV tier omits it, and that is also deliberate: `inboxCsv` names its
  // columns explicitly and the CSV is the tier a person reads, where an internal
  // key is noise. json.test.ts asserts the presence so this cannot quietly flip.
  //
  // Prisma CAN express this one, so unlike the CHECK constraints above it needs no
  // registry entry — and it is deliberately NOT in
  // src/lib/enum-constraint-sync.integration.test.ts, which polices CHECKs and the
  // enum/range/length registries. The behavioural half, proving the index bites
  // and that nulls and cross-workspace duplicates are both allowed, is
  // src/lib/braindump-client-key-unique.integration.test.ts.
  clientKey            String?
  taskId               String?
  task                 Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workspaceId          String
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, clientKey])
  @@index([status])
  @@index([workspaceId])
}

// ── Feature 2 — Task Breakdown → Scheduling ───────────────────────────────
model Task {
  id               String          @id @default(cuid())
  title            String
  source           String          @default("braindump") // braindump | manual
  createdAt        DateTime        @default(now())
  status           String          @default("active") // active | done | archived
  parentEmoji      String?
  googleTaskId     String?
  googleTaskListId String?
  scheduledAt      DateTime? // when the task was first scheduled (any method)
  scheduledVia     String? // "ics" | "google" (method-agnostic marker)
  // #106 — what the owner asked for the last time this task was scheduled
  // through the Schedule menu, so re-opening it prefills instead of asking
  // again. Null until they have said something: `defaultIntentFor()`
  // (src/lib/scheduling/intent.ts) supplies the fallback, which is why these are
  // nullable with NO column default — a default would freeze "3 days from the
  // migration date" and would also make "the owner chose this" indistinguishable
  // from "nobody has said yet", the very distinction prefill needs.
  // The two pseudo-enum columns mirror SchedulePriority / ScheduleHours in
  // src/lib/scheduling/types.ts and are CHECK-constrained by
  // 20260729120000_task_schedule_intent; Prisma can't express a CHECK, so these
  // comments are their only trace in the schema and the constraints are
  // registered in src/lib/enum-constraint-sync.integration.test.ts.
  scheduleDueAt    DateTime?
  schedulePriority String? // critical | high | normal | low
  scheduleHours    String? // work | personal
  // #44 — the owner's freeform note on this task, threaded into the scheduled
  // artifact (ICS VEVENT DESCRIPTION + Google Task notes) alongside the #39
  // focus deep-link. Nullable, and the NULL is load-bearing: "nobody has
  // written a note" is what stops an empty line being composed into somebody's
  // calendar entry, so `normalizeTaskNote` (src/lib/task-notes.ts) folds "" and
  // whitespace-only back to NULL rather than storing them.
  // Bounded at 2000 CHARACTERS by Task_notes_check
  // (20260805120000_task_and_step_notes) — Google Tasks rejects a `notes` value
  // over 8192 characters and this is one part of that envelope. Prisma can't
  // express a CHECK, so that migration and this comment are its only trace in
  // the schema; it is registered in
  // src/lib/enum-constraint-sync.integration.test.ts (LENGTH_REGISTRY) so
  // dropping it out of band fails the suite.
  // `Step.notes` is the per-step twin, same bound and same migration. When both
  // exist for one scheduled step, BOTH are composed into the artifact — see
  // buildScheduleNote in src/lib/scheduling/note.ts for why.
  notes            String?
  steps            Step[]
  turns            BreakdownTurn[]
  brainDumpItems   BrainDumpItem[]
  workspaceId      String
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Step {
  id               String         @id @default(cuid())
  taskId           String
  task             Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text             String
  order            Int
  total            Int
  // #78 — always >= 1 whole minute, enforced in the DB by
  // Step_estMinutes_check (20260727194512_step_est_minutes_check). Prisma
  // can't express a CHECK constraint, so this comment is its only trace in
  // the schema; it is registered alongside the pseudo-enum constraints in
  // src/lib/enum-constraint-sync.integration.test.ts (RANGE_REGISTRY).
  //
  // #80 — BrainDumpItem.estMinutes is the nullable counterpart, constrained
  // `IS NULL OR >= 1`. Read the note there before assuming either shape is a
  // copy of the other.
  estMinutes       Int
  subtaskEmoji     String?
  googleTaskId     String? // id of the synced Google Task (Reclaim ingests it downstream)
  googleTaskListId String?
  scheduledAt      DateTime?
  done             Boolean        @default(false)
  // #44 — the per-step twin of `Task.notes`: context for THIS step, threaded
  // into that step's own calendar event / Google Task alongside the task's
  // note. Same 2000-character bound, same migration
  // (20260805120000_task_and_step_notes), enforced by Step_notes_check, which
  // Prisma also cannot express — read the note on `Task.notes` for the
  // reasoning behind the number and the choice of char_length.
  notes            String?
  estimateHistory  String? // JSON array of prior estMinutes values
  createdAt        DateTime       @default(now())
  focusSessions    FocusSession[]

  // #245 — the constraint `ensureFocusStep` needs and could not have. Two ▶ Focus
  // presses against a task with no steps take no row lock (the item's `taskId` is
  // already set, so #225's Task guard is skipped), both read `steps: []` and both
  // insert; an INSERT's precondition cannot live in a `where`. With this index the
  // second insert is an `ON CONFLICT DO NOTHING` no-op — the shape `src/lib/db.ts`
  // prescribes and that action's docblock could not use until now — so the loser
  // adopts instead of duplicating, and nothing is printed at error level.
  //
  // Safe against both existing step writers, and the migration
  // (20260811120000_step_task_order_unique) carries the argument plus the repair
  // pass for data that already holds duplicates. A future reorder-by-SWAP would
  // collide here, loudly, which is the right way round.
  @@unique([taskId, order])
  @@index([taskId])
}

model BreakdownTurn {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  role          String // user | assistant
  message       String
  proposedSteps String? // JSON snapshot of proposed chunks
  createdAt     DateTime @default(now())

  @@index([taskId])
}

// ── Feature 3 — Focus Timer ───────────────────────────────────────────────
model FocusSession {
  id                  String    @id @default(cuid())
  stepId              String?
  step                Step?     @relation(fields: [stepId], references: [id], onDelete: SetNull)
  taskId              String?
  plannedMin          Int
  addedMin            Int       @default(0)
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  durationMin         Int?
  outcome             String? // completed | requeued | gaveup
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // #27 — true pause/resume. `pausedAt` set = the session is currently paused
  // (this, not `endedAt: null` alone, is what "resumable" means now — an
  // open-but-never-paused session is stale/abandoned, not resumable).
  // `accumulatedPausedMs` sums every prior pause interval's duration, so
  // remaining time = plannedMin*60 - (now|pausedAt - startedAt - accumulatedPausedMs)/1000
  // stays correct across any number of pause/resume cycles. See
  // src/lib/focus-timer-clock.ts `remainingSecForSession`.
  pausedAt            DateTime?
  accumulatedPausedMs Int       @default(0)

  @@index([stepId])
  @@index([workspaceId])
}

// #185 — a workspace's OWN named focus playlist.
//
// `trackIds` is a flat list of catalogue track ids and stores no category
// reference at all, which is the whole model rather than an implementation
// detail: adding a category COPIES its tracks in at add time, so a catalogue
// that later grows can never change what a saved playlist plays.
//
// It is deliberately not CHECK-constrained. Track ids are catalogue data that
// varies per instance — a self-hoster with no FOCUS_CATALOG_ORIGIN has a
// different set entirely — so a constraint would reject a perfectly good
// playlist carried over from another install. Unknown ids are filtered at
// resolution time instead (`resolveFocusPool` in src/lib/focus-sounds.ts), the
// same treatment an absent category already gets. What IS constrained is size:
// `FocusPlaylist_name_check` bounds the name, and the action bounds the array
// (see MAX_FOCUS_PLAYLIST_TRACKS in src/lib/focus-playlists.ts).
//
// `@@unique([workspaceId, name])` is the exact-spelling half of the uniqueness
// rule; the case-insensitive half lives in the action, which is where the whole
// story is written down.
model FocusPlaylist {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  trackIds    String[]  @default([])
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model DayRollup {
  id           String    @id @default(cuid())
  date         String // YYYY-MM-DD
  focusMin     Int       @default(0)
  sessions     Int       @default(0)
  stepsDone    Int       @default(0)
  pointsEarned Int       @default(0)
  streakDay    Int       @default(0)
  narrative    String?
  emailedAt    DateTime?
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
}

// ── Feature 4 — Rewards & Streaks ─────────────────────────────────────────
model RewardEvent {
  id          String    @id @default(cuid())
  type        String // step_done | session_finished | inbox_zero | breakdown_confirmed | scheduled
  points      Int
  createdAt   DateTime  @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([workspaceId])
}

model Streak {
  id                String    @id @default(cuid())
  current           Int       @default(0)
  lastActiveWorkday String? // YYYY-MM-DD
  workspaceId       String    @unique
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model StreakRecord {
  id          String    @id @default(cuid())
  length      Int
  startedAt   DateTime
  endedAt     DateTime
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([length])
  @@index([workspaceId])
}

model Badge {
  id          String    @id @default(cuid())
  key         String // first_breakdown | first_schedule | streak_5 | ten_steps_day | beat_best_streak
  earnedAt    DateTime  @default(now())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model DailySpark {
  id          String    @id @default(cuid())
  date        String // YYYY-MM-DD
  quote       String
  source      String // ai | fallback
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
}

// ── #199 — Shopping list mode ─────────────────────────────────────────────
// A list-shaped thing that is NOT a task: no estimate, no steps, no calendar
// block, no streak credit. Its own table specifically so the focus, scheduling
// and reward machinery cannot see it — `beginFocus`/`completeStep` do no
// kind-check, so a shopping item stored as a `Step` would be focusable and
// streak-earning by default and would need an "unless this is shopping" check at
// every one of those call sites, forever.
//
// Behind Settings.shoppingList (off by default), gated server-side on
// /shopping itself rather than only by hiding the menu entry.
model ShoppingItem {
  id            String    @id @default(cuid())
  text          String
  done          Boolean   @default(false)
  // The undated "saved for later" section. ONE boolean, and there is deliberately
  // no date, no snooze column and no scheduler involvement: nothing here
  // reappears on its own, it is pulled back up by hand. That is what makes this
  // list visibly outside the scheduling machinery instead of looking broken.
  savedForLater Boolean   @default(false)
  // Capture order, same idea as Step.order. Allocated as max+1 by
  // nextShoppingOrder (src/lib/shopping.ts), so two concurrent adds can duplicate
  // a value; splitShoppingList breaks the tie on `id` so the rendered order is
  // stable across reads rather than reshuffling between page loads.
  order         Int
  createdAt     DateTime  @default(now())
  // Bounded at 200 CHARACTERS by ShoppingItem_text_check
  // (20260808120000_shopping_items), which also refuses whitespace-only text.
  // Prisma can't express a CHECK, so that migration and this comment are its only
  // trace in the schema; it is registered in
  // src/lib/enum-constraint-sync.integration.test.ts (LENGTH_REGISTRY) so
  // dropping it out of band fails the suite. The bound lives in
  // SHOPPING_ITEM_TEXT_MAX_LENGTH (src/lib/shopping.ts).
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// #199 — the inbox's shopping-list summary line.
//
// ONE ROW PER WORKSPACE, and it stores WHETHER to show a summary — never HOW MANY.
// The count is derived from ShoppingItem at render time (see
// src/lib/shopping-summary.ts), which is what makes "the count can never disagree
// with the list" structural rather than a maintenance promise: there is no second
// copy of the number to drift. A missed sync can only leave the row outliving the
// list, and the read side answers that with no summary at all.
//
// Its own table rather than a generated BrainDumpItem, because a generated row in
// that table is visible to every query against it — and two of those are not
// cosmetic. maybeAwardInboxZero counts un-triaged inbox items, so a permanent row
// would make inbox zero unreachable for anyone keeping a shopping list; and
// bucketItems files items by status/snoozedUntil/completedAt, so dismissing the
// summary would drop it into the Library's "saved for later" or "done" tabs.
//
// `workspaceId` IS the primary key, so the summary is single-per-workspace
// structurally and `upsert` on it is the whole concurrency story — two concurrent
// adds cannot create two rows.
//
// Deliberately absent from the data export: it is app-generated bookkeeping the
// user never typed, and it says nothing their own ShoppingItem rows do not. Listed
// with that reason in DELIBERATELY_EXCLUDED
// (src/lib/export/__tests__/model-coverage.test.ts) and its absence is asserted in
// src/lib/export/json.test.ts, so the exclusion can never be mistaken for hiding
// real user data.
model ShoppingSummary {
  workspaceId String    @id
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  // When the summary was dismissed from the inbox. Cleared again by the next
  // shopping write that can INCREASE the count — adding an item, un-ticking one,
  // or pulling one back up from saved-for-later. Ticking off, saving for later,
  // deleting and renaming leave a dismissal alone: a change that cannot make the
  // list longer is not a new reason to remind anybody.
  //
  // One column, not a tick and a snooze: the issue asks for snoozing to behave
  // consistently with ticking off, and one gesture with one meaning is the most
  // consistent that gets.
  clearedAt   DateTime?
}

// ── Phase 2 — guest AI allowance (IP-hash scoped, rolling window) ──────────
// No PII: ipHash is a salted hash of the client IP. count/window enforce the
// per-guest breakdown allowance; rows are self-expiring by window.
model GuestAiUsage {
  ipHash          String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Phase 2 — global daily distinct-guest tally (circuit breaker) ──────────
// One row per (UTC day, ipHash); count of rows for a day = distinct guests
// that used AI that day. Presence = "this guest used AI today".
model GuestDailyActivity {
  day       String // UTC date YYYY-MM-DD
  ipHash    String
  createdAt DateTime @default(now())

  @@id([day, ipHash])
  @@index([day])
}
