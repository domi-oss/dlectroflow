# dlectroflow environment variables — copy to .env.local and fill in.
# .env.local is gitignored; never commit real secrets.

# Claude API (server-side only)
ANTHROPIC_API_KEY=

# Database — SQLite locally, Postgres for deploy (Prisma reads this)
DATABASE_URL="file:./dev.db"

# Reclaim MCP (set once the OAuth flow is wired at build step 6)
# Bearer token obtained from the mcp.reclaim.ai OAuth authorize flow.
RECLAIM_MCP_URL="https://mcp.reclaim.ai"
RECLAIM_AUTH_TOKEN=

# Email round-up (opt-in, build step 9) — Resend
RESEND_API_KEY=
ROUNDUP_FROM_EMAIL=
