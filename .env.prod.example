# dlectroflow — production environment for the single-host Docker Compose stack.
#
#   cp .env.prod.example .env.prod   then fill in every value marked REQUIRED.
#
# Walkthrough: docs/self-host-vps.md
#
# `.env.prod` is gitignored. It holds real secrets — keep it 0600 and never
# commit it. Everything here is read by docker/docker-compose.prod.yml, which points at
# this file as `../.env.prod` — keep it here at the repo root, not in docker/.
#
# NOTE: DATABASE_URL is deliberately NOT in this file. docker/docker-compose.prod.yml
# composes it from the POSTGRES_* values below, so the app's connection string
# and the database's own credentials cannot drift apart.
#
# PARITY (#135): this file and the Helm chart (charts/dlectroflow/templates/
# secret.yaml + deployment.yaml) are the two configuration surfaces of the same
# app, and src/lib/env-drift.test.ts now DIFFS them. Adding a key here means
# adding a chart equivalent too, or recording the divergence in
# CONFIG_SURFACE_ALLOWLIST (src/lib/env-drift.ts) with a reason. A commented-out
# `# KEY=` counts as declared — that is how this file marks an optional var.

# ── REQUIRED: your domain ────────────────────────────────────────────────────

# The hostname Caddy will obtain a Let's Encrypt certificate for. Its DNS A/AAAA
# record must already point at this host, and ports 80 and 443 must be reachable
# — Let's Encrypt validates over port 80.
DLECTROFLOW_DOMAIN=dlectroflow.example.com

# Where the app believes it lives. Pins OAuth redirect URIs and the Secure cookie
# flag so neither can be steered by a spoofed Host or X-Forwarded-* header.
# Must be the https:// form of DLECTROFLOW_DOMAIN, with no trailing slash.
PUBLIC_ORIGIN=https://dlectroflow.example.com

# Want Let's Encrypt to email you about certificate problems? That is set
# directly in docker/Caddyfile — uncomment the `email` block at the top of it. It is
# deliberately not an environment variable: Caddy treats an empty `email` value
# as a syntax error and crash-loops, which looks like a networking fault.

# ── REQUIRED: database ───────────────────────────────────────────────────────
# Postgres runs in this stack and is never published to the internet.
#
# Use an alphanumeric password. It is interpolated into a connection URL, so
# characters like @ : / ? # would need percent-encoding.
#   openssl rand -hex 24
POSTGRES_USER=dlectroflow
POSTGRES_PASSWORD=CHANGEME-run-openssl-rand-hex-24
POSTGRES_DB=dlectroflow

# ── REQUIRED: sign-in ────────────────────────────────────────────────────────
# The app refuses to boot in production if any of this block is missing or too
# short — see assertAuthConfig() in src/lib/auth/config.ts. That is deliberate:
# a half-configured instance would expose data.

AUTH_PROVIDER=gitlab

# Who is allowed in, comma-separated. Sign-in is invite-only: an OAuth identity
# only becomes an account if it matches here. A GitLab numeric user id is the
# most robust form (a username can be changed by its owner); a username or email
# also match, case-insensitively. Everyone else gets a guest sandbox.
# Find your numeric id at https://gitlab.com/api/v4/users?username=YOUR_USERNAME
OWNER_ALLOWLIST=

# Session signing key, 32+ characters.
#   openssl rand -base64 48
AUTH_SESSION_SECRET=

# GitLab OAuth application: GitLab → Settings → Applications → Add new.
#   Redirect URI: https://YOUR-DOMAIN/api/auth/gitlab/callback
#   Scope:        read_user   (nothing else — it only needs your identity)
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# Salts the hash of a guest's IP address so the raw IP is never stored.
# 16+ characters.
#   openssl rand -hex 16
GUEST_IP_HASH_SALT=

# AES-256-GCM key encrypting stored OAuth tokens (#21). Exactly 64 hex chars.
#   openssl rand -hex 32
#
# Rotating this makes existing encrypted tokens unreadable, so anyone who has
# connected Google will need to reconnect once.
TOKEN_ENC_KEY=

# ── REQUIRED: the AI model (pick ONE of the two blocks) ──────────────────────

# Option A — hosted Claude (the default). Key from
# https://console.anthropic.com → API keys. Roughly $0.005 per breakdown on
# Haiku, $0.025 on Sonnet, $0.05 on Opus; see docs/running-costs.md.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Option B — a model you run yourself (Ollama, LM Studio, vLLM) or another
# vendor with an OpenAI-compatible API. Costs nothing but electricity.
# Comment out Option A above and uncomment these; LLM_BASE_URL and LLM_MODEL are
# both required in production when the provider is openai-compatible.
#
# ⚠️ This path is unit-tested only. No one has yet run it against a real
# non-Anthropic endpoint, so treat it as experimental — see the BYO-LLM section
# of README.md.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=
# Optional owner/guest model split; each falls back to LLM_MODEL when unset.
# These are the openai-compatible counterparts to the OWNER_BREAKDOWN_MODEL /
# GUEST_BREAKDOWN_MODEL pair further down, which only apply to `anthropic`.
# LLM_OWNER_MODEL=
# LLM_GUEST_MODEL=
# Set false if the model cannot do native tool calls (falls back to JSON-in-text).
# LLM_SUPPORTS_TOOLS=true

# ── Optional: which image to run ─────────────────────────────────────────────
# Defaults to `dlectroflow:local`, i.e. the image you build yourself with
#   docker build -f docker/Dockerfile -t dlectroflow:local .
# Point this at a published tag instead to skip building. Note the project's
# container registry is currently private, so a published image needs
# `docker login registry.gitlab.com` first.
# DLECTROFLOW_IMAGE=registry.gitlab.com/gl-demo-ultimate-dtop/domi-oss/dlectroflow:v0.4.0

# ── Strongly recommended: get the backup OFF this host (#162) ────────────────
# The `backup` service dumps the database to ./backups on THIS machine. That
# copy shares a failure domain with the database it protects, and the database
# is the one asset here that cannot be rebuilt from source — so the single
# failure a backup exists to survive, losing the host, takes it with it.
#
# Set these and the `backup-upload` service copies every dump to a Backblaze B2
# bucket under the same filename the local copy gets, so the two are matchable.
# B2's free tier is 10 GB; a dump of this database is tens of kilobytes. Leave
# them unset if you copy the dumps off some other way (restic, rsync, provider
# snapshots) — `backup` alone still works, and `backup-upload` refuses to run
# rather than pretending to.
#
# Full walkthrough, including the crontab line and how to restore: the Backups
# section of docs/self-host-vps.md.
#
# ⚠️ Scope the application key to this ONE bucket and this ONE prefix, with
# `writeFiles` and nothing else. A host that cannot read or delete its own
# backups is a host whose compromise cannot destroy them. Listing, downloading
# and restoring then need a second, read-capable key that stays on your
# workstation — which is where a restore drill belongs anyway.
# B2_BUCKET=
# B2_PREFIX=pg
# B2_KEY_ID=
# B2_APP_KEY=

# ── Optional: Google Tasks (scheduling) ──────────────────────────────────────
# Lets confirmed steps land in your Google Tasks list, which Reclaim.ai can then
# auto-schedule. Without it, steps still save locally and export as .ics.
# Create an OAuth client in Google Cloud Console, enable the Google Tasks API,
# and add redirect https://YOUR-DOMAIN/api/google/oauth/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TASKS_LIST_NAME=reclaim

# Which title syntax scheduled tasks are written in (#104). Detected from the
# list name by default — a list matching "reclaim" gets Reclaim's parenthetical
# parameters, anything else gets a clean title plus Google Tasks' native due
# date. Set to "reclaim" or "plain" to override the detection.
# SCHEDULING_SYNTAX=

# The timezone the scheduling windows are computed in (working hours are
# Mon–Fri 08:30–18:00 work, evenings + weekends personal). Defaults to
# Europe/London; set an IANA zone if you are self-hosting elsewhere.
# SCHEDULING_TIMEZONE=Europe/London

# ── Optional: end-of-day round-up email ──────────────────────────────────────
# The in-app and desktop round-ups work without this. Free tier is plenty.
# RESEND_API_KEY=
# ROUNDUP_FROM_EMAIL="dlectroflow <you@yourdomain.com>"

# ── Optional: guest limits and model tiers ───────────────────────────────────
# Guests are unauthenticated visitors in a throwaway sandbox. These caps are what
# stop a public instance running up your model bill.
GUEST_AI_QUOTA_PER_WINDOW=5
GUEST_AI_WINDOW_HOURS=24
GUEST_GLOBAL_DAILY_GUEST_CAP=10
GUEST_SANDBOX_TTL_HOURS=24

# Which model each tier uses (anthropic provider only).
OWNER_BREAKDOWN_MODEL=claude-sonnet-4-6
GUEST_BREAKDOWN_MODEL=claude-haiku-4-5

# Rolling window a signed-in account's AI usage is measured over, in hours.
# 720 = 30 days, sliding from that person's first breakdown.
USER_AI_WINDOW_HOURS=720
